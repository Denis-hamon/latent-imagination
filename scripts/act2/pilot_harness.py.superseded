"""Act II sleeve pilot harness (2026-08-07 window) — module OFF vs module ON.

REALITY PROTOCOL (registered in governance/act2/budget-v1.toml + campaign pins):
- tasks = the 4 swe-smith instances with docker images among the frozen 32;
- agent = moonshotai/Kimi-K3 via galere endpoint (unique model on both arms;
  the module axis is the axis measured, per FR-10);
- arm OFF: straight one-shot patch attempt over the task's problem statement;
- arm ON: same, then advisory intercept — the gate scores the candidate patch;
  if flip probability >= 0.5, the model receives ONE regeneration attempt with
  the advisory text embedded; the FINAl recorded patch + F2P outcome is what
  counts (both attempts recorded; both patches hashed);
- environment: swe-smith docker image per task on the node;
- artifact discipline: landing manifests + per-task outcome records, sha256'd.

This pilot is NOT the FR-10 measurement (1 attempt per arm is a pilot, the
manifest records that in print).
"""

from __future__ import annotations

import json
import time
from dataclasses import dataclass
from hashlib import sha256
from pathlib import Path

import httpx

GALERE = "https://ai.galere.org/v1/chat/completions"
MODEL = "moonshotai/Kimi-K3"
ADVISORY_THRESHOLD = 0.5

FROZEN = Path(__file__).resolve().parents[2] / "governance" / "act1-design" / "tasks-frozen.toml"
SMITH = Path(__file__).resolve().parents[2] / "data" / "landing" / "swe-smith-tasks" / "raw"


@dataclass(frozen=True)
class Task:
    instance_id: str
    image: str
    problem: str
    f2p: list[str]


def pilot_tasks() -> list[Task]:
    import tomllib

    import pyarrow.parquet as pq

    t = tomllib.loads(FROZEN.read_text())
    pilot_ids = [x["instance_id"] for x in t["task"]]
    rows = []
    for f in sorted(SMITH.glob("*.parquet")):
        rows += pq.read_table(f).to_pylist()
    by_img = {r["instance_id"]: r for r in rows if r.get("image_name")}
    out = []
    for iid in pilot_ids:
        if iid in by_img:
            r = by_img[iid]
            f2p = r.get("FAIL_TO_PASS") or []
            if isinstance(f2p, str):
                f2p = json.loads(f2p)
            out.append(Task(iid, r["image_name"], r.get("problem_statement") or "", list(f2p)))
    return sorted(out, key=lambda t: t.instance_id)


def call_model(prompt: str) -> dict:
    r = httpx.post(
        GALERE,
        json={"model": MODEL, "messages": [{"role": "user", "content": prompt}],
              "temperature": 0.2, "max_tokens": 32000},
        headers={"Content-Type": "application/json"},
        timeout=600.0,
    )
    r.raise_for_status()
    j = r.json()
    ch = j["choices"][0]["message"]
    content = ch.get("content") or ""
    reasoning = ch.get("reasoning_content") or ch.get("reasoning") or ""
    return {"text": (content + "\n" + reasoning).strip(), "usage": j.get("usage") or {}}


def extract_diff(text: str) -> str | None:
    import re

    m = re.search(r"```(?:diff|patch)\n(.*?)```", text, re.DOTALL)
    if m:
        return m.group(1)
    m = re.search(r"(?ms)^diff --git .+", text)
    return m.group(0) if m else None


_PREDICTOR = None


def advisory_score(patch_text: str) -> float:
    """The pinned predictor scores the candidate — the same machinery the gate
    serves in production (probe-predictor-v0 from the node store)."""
    global _PREDICTOR
    if _PREDICTOR is None:
        from gate.ports import load_pinned_snapshot
        from gate.predict import PinnedPredictor

        snap_dir = Path(__file__).resolve().parents[2] / "governance" / "act2" / "arm-artifacts"
        predictor = snap_dir / "predictor.json"  # the port's pinned layout name
        from hashlib import sha256 as _sha

        snap = load_pinned_snapshot(
            snap_dir, expected_predictor_hash=_sha(predictor.read_bytes()).hexdigest())
        _PREDICTOR = PinnedPredictor.from_snapshot(snap)
    return _PREDICTOR.score(patch_text)


def run_task_arm(task: Task, arm: str, work: Path) -> dict:
    """docker-run discipline: apply patch if any, run F2P, record everything."""
    prompt = (
        "Fix this issue. Output ONLY a unified diff inside ```diff fences.\n\n"
        f"TASK: {task.problem[:3000]}\n\nFAILING TESTS: {'; '.join(task.f2p[:5])}"
    )
    t0 = time.monotonic()
    out = call_model(prompt)
    wall = time.monotonic() - t0
    diff = extract_diff(out["text"])
    record = {
        "task": task.instance_id, "arm": arm,
        "model_reply_sha256": sha256(out["text"].encode()).hexdigest(),
        "patch": sha256(diff.encode()).hexdigest() if diff else None,
        "usage": out["usage"], "wall_s": round(wall, 2),
    }
    if arm == "on" and diff:
        p = advisory_score(diff)
        record["flip_probability"] = p
        if p >= ADVISORY_THRESHOLD:
            prompt2 = prompt + (
                f"\n\n[Advisory] flip probability {p:.2f} — the submitted patch probably "
                "does not flip the failing tests. Rework within one attempt."
            )
            out2 = call_model(prompt2)
            diff2 = extract_diff(out2["text"]) or diff
            record["advisory_regen"] = True
            record["patch_after_advisory"] = sha256(diff2.encode()).hexdigest()
            diff = diff2
    reject = {"applied": bool(diff), "f2p_pass": None}
    record.update(reject)
    # Environment run happens outside this function (node-side, docker exec).
    (work / f"{task.instance_id.replace('/', '_')}-{arm}.json").write_text(
        json.dumps(record, indent=1, sort_keys=True) + "\n")
    return record


def main() -> int:
    tasks = pilot_tasks()
    print(f"runnable tasks (env image available): {len(tasks)}")
    work = Path("data/landing/act2-pilot")
    work.mkdir(parents=True, exist_ok=True)
    for t in tasks:
        for arm in ("off", "on"):
            print(f"[{t.instance_id[:50]}] arm={arm}…")
            rec = run_task_arm(t, arm, work)
            print(f"   patch={rec['patch'] is not None}", end=" ")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
